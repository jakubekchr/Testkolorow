<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"

    android:background="#123456"
    tools:context=".MainActivity">
<!--    obowiazkowo musi byc do kazdego obiektu szerokosc i wysokosc
        - match parent to rozmiar rodzica
        - wrap content to rozmiar zawartosci
 -->

    <TextView
        android:id="@+id/textviewpyt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:padding="8dp"
        android:text="Wybierz kolor ktory jest na fladze polski ? "
        android:textColor="#7D41FF"
        android:textSize="32sp"

        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">


        <Button
            android:onClick="sprawdzOK"
            android:layout_margin="5dp"
            android:textSize="16sp"
            android:textColor="#7D41FF"
            android:id="@+id/button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="#FF0000"
            android:text="Czerwony" />


        <Button
            android:onClick="ukryj"
            android:layout_margin="5dp"
            android:textSize="16sp"
            android:textColor="#7D41FF"
            android:id="@+id/button2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="#FFC107"
            android:text="Zolty" />


        <Button
            android:layout_margin="5dp"
            android:textSize="16sp"
            android:textColor="#7D41FF"
            android:id="@+id/button3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="#F44336"
            android:text="Pomaranczowy"
            android:onClick="ukryj"
            />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:onClick="sprawdzOK"
            android:backgroundTint="#FFFFFF"
            android:layout_margin="5dp"
            android:textSize="16sp"
            android:textColor="#7D41FF"
            android:id="@+id/button4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Bialy"
            tools:ignore="OnClick" />

        <Button
            android:backgroundTint="#8BC34A"
            android:layout_margin="5dp"
            android:textSize="16sp"
            android:textColor="#7D41FF"
            android:id="@+id/button5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Zielony"
            android:onClick="ukryj"/>

        <Button
            android:backgroundTint="#2196F3"
            android:layout_margin="5dp"
            android:textSize="16sp"
            android:textColor="#7D41FF"
            android:id="@+id/button6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Niebieski"
            android:onClick="ukryj"/>
    </LinearLayout>

</LinearLayout>